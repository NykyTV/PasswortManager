<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Custom Quickstart without Braces"
         xmlns="https://pmd.github.io/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://pmd.github.io/ruleset/2.0.0
                             https://pmd.github.io/ruleset_2_0_0.xsd">

    <description>
        PMD 7 Quickstart ruleset ohne die Regel "Braces".
    </description>

    <!-- Quickstart-Regeln laden -->
    <rule ref="category/java/quickstart.xml">
        <!-- Diese Regel explizit ausschließen -->
        <exclude name="Braces"/>
    </rule>

</ruleset>
