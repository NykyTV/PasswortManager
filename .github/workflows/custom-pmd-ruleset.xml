<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Custom Quickstart without Braces"
         xmlns="https://pmd.github.io/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://pmd.github.io/ruleset/2.0.0
                             https://pmd.github.io/ruleset_2_0_0.xsd">

    <description>
        PMD Quickstart ruleset ohne die "Braces"-Regel (This statement should have braces).
    </description>

    <!-- Design -->
    <rule ref="category/java/design.xml/SimplifyBooleanExpressions"/>
    <rule ref="category/java/design.xml/SimplifyConditional"/>
    <rule ref="category/java/design.xml/UseCollectionIsEmpty"/>

    <!-- Error Prone -->
    <rule ref="category/java/errorprone.xml/MethodArgumentCouldBeFinal"/>
    <rule ref="category/java/errorprone.xml/AvoidAssertAsIdentifier"/>
    <rule ref="category/java/errorprone.xml/ComparisonWithNaN"/>
    <rule ref="category/java/errorprone.xml/ReturnFromFinallyBlock"/>

    <!-- Best Practices -->
    <rule ref="category/java/bestpractices.xml/AvoidPrintStackTrace"/>
    <rule ref="category/java/bestpractices.xml/AvoidThrowingNullPointerException"/>
    <rule ref="category/java/bestpractices.xml/MethodReturnsInternalArray"/>
    <rule ref="category/java/bestpractices.xml/ClassWithOnlyPrivateConstructorsShouldBeFinal"/>
    <!-- Braces ist hier normalerweise drin, wurde aber absichtlich weggelassen -->

    <!-- Code Style -->
    <rule ref="category/java/codestyle.xml/UnnecessaryImport"/>
    <rule ref="category/java/codestyle.xml/UnnecessaryConstructor"/>
    <rule ref="category/java/codestyle.xml/AtLeastOneConstructor"/>
    <rule ref="category/java/codestyle.xml/UseUnderscoresInNumericLiterals"/>

    <!-- Documentation -->
    <rule ref="category/java/documentation.xml/CommentRequired"/>

    <!-- Multithreading -->
    <rule ref="category/java/multithreading.xml/AvoidUsingVolatile"/>

    <!-- Performance -->
    <rule ref="category/java/performance.xml/AvoidInstantiatingObjectsInLoops"/>

    <!-- Security -->
    <rule ref="category/java/security.xml/InsecureCryptoIv"/>
    <rule ref="category/java/security.xml/InsecureCryptoMode"/>
</ruleset>
